# Part B: Cramer's V
def cramers_v(table):
    chi2, p, dof, _ = st.chi2_contingency(table)
    n = table.sum().sum()                # total count in the table
    k = min(table.shape) - 1             # min(rows, columns) - 1
    return np.sqrt(chi2 / (n * k))       # the formula for V

