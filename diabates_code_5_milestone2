def contract(frame):
    """Return {rule: True/False}. All True means the file matches the contract."""
    return {
        "patientId is unique":          frame["patient_id"].is_unique,
        "age is number 1-100":         frame["age"].between(1, 100).all(),
        "family history of diabetes":    frame["family_history_diabetes"].isin(["Yes", "No"]).all(),
        "Sex male or female or other":  frame["gender"].isin(["Male", "Female", "Other"]).all(),
        "diabetes risk":                frame["diabetes_risk"].isin(["High","Moderate","Low"]).all(),
        "waist_circumference":           frame["waist_circumference_cm"].between(1, 150).all(),
    }

