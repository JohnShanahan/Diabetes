def run_pipeline(input_glob, output_prefix, extra=()):

    """Run diabetes_pipeline.py locally. Returns (exit code, counters as a dict, seconds taken)."""

    args = [PY,"diabetes_pipeline.py", "--runner", "DirectRunner", "--input", input_glob, "--output", output_prefix,
        *extra]

    start = time.time()
    code, out = run(args)
    counters = {m.group(1): int(m.group(2))
        for m in re.finditer(
        r"^\s{2}(\w+)\s+(\d+)\s*$",
        out,
        flags=re.M
        )
    }
    return code, counters, time.time() - start


