  def profile(series):
    observed = series.dropna()
    q1, q3 = observed.quantile([0.25, 0.75])
    return pd.Series({
        "n": observed.size,
        "missing": series.isna().sum(),
        "mean": observed.mean(),
        "median": observed.median(),
        "std": observed.std(),
        "IQR": q3 - q1,
        "min": observed.min(),
        "max": observed.max(),
        "skew": observed.skew()
    })

summary = df[["Age", "Fare", "SibSp", "Parch"]].apply(profile).T
display(summary)



